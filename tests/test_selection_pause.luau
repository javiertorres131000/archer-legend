local M = require("./mocks")
require("./GameServer")
local Run = require("./Run")
local Progression = require("./Progression")
local PlayerData = require("./PlayerData")
local PlayerLife = require("./PlayerLife")
local Enemies = require("./Enemies")
local Combat = require("./Combat")
local Remotes = require("./Remotes")
local Config = require("./Config")
local a, b = M.addPlayer("Ana"), M.addPlayer("Beto")
Run.start(1, { a, b })
Run.step(0.01)
local sa, sb = PlayerData.get(a), PlayerData.get(b)
local roots = { a.Character.HumanoidRootPart, b.Character.HumanoidRootPart }
assert(Config.Progression.PauseWhileChoosing and Config.Progression.ChoosingShield)
Progression.giveChoice(a)
assert(Remotes.GameState:GetAttribute("ChoosingPaused"))
assert(roots[1].Anchored and roots[2].Anchored, "se congelan ambos aunque sólo Ana elija")
assert(not require("./Dash").request(b, M.Vector3.new(1, 0, 0)))
local targets = PlayerData.getAliveTargets()
local enemy = Enemies.spawn("HeavyKnight", M.Vector3.new(8, 0, 0))
Enemies.applyBurn(enemy, 1, 3, a)
Combat.fireEnemyProjectile(roots[2].Position, M.Vector3.new(1, 0, 0))
local count, pos, health = Combat.count(), enemy.part.Position, b.Character.Humanoid.Health
for _ = 1, 30 do M.advance(0.1); Run.step(0.1) end
assert(enemy.part.Position.X == pos.X and enemy.part.Position.Z == pos.Z)
assert(Combat.count() == count, "proyectiles no avanzan ni desaparecen mientras se elige")
assert(enemy.health == enemy.maxHealth, "la quemadura no hace daño durante la pausa")
for _, target in targets do PlayerLife.damage(target, 10000) end
assert(b.Character.Humanoid.Health == health, "el compañero también queda protegido")
Progression.giveChoice(b)
Remotes.ChooseSkill.OnServerEvent:Fire(a, sa.offerId, 1)
assert(Remotes.GameState:GetAttribute("ChoosingPaused") and roots[1].Anchored)
Remotes.ChooseSkill.OnServerEvent:Fire(b, sb.offerId, 1)
assert(not Remotes.GameState:GetAttribute("ChoosingPaused"))
assert(not roots[1].Anchored and not roots[2].Anchored, "al elegir todos se restaura el movimiento")
assert(not a.Character:FindFirstChild("ChoiceShield"))
Run.step(0.1)
assert(enemy.health < enemy.maxHealth, "la quemadura reanuda sin consumir su duración durante la pausa")
Progression.giveChoice(a)
Run.cleanup()
assert(not PlayerData.isPaused() and not Remotes.GameState:GetAttribute("ChoosingPaused"))
print("Selección: pausa global, inmunidad, proyectiles, temporizadores, cooperación y limpieza OK")
